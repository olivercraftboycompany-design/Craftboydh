  "phrases": [
    {"velu":"Mi pan mel.","english":"I eat bread."},
    {"velu":"Mi pan ta mel.","english":"I am eating bread."},
    {"velu":"Mi pan no ra mel.","english":"I did not eat bread."},
    {"velu":"Mi a urb ga.","english":"I go to the city."},
    {"velu":"Lo bone pal.","english":"He/she speaks well."},
    {"velu":"Mi nin so.","english":"I am a child."},
    {"velu":"Lo kan gran ten.","english":"He/she has a big dog."},
    {"velu":"Tuji ta pal ka?","english":"Are you all speaking?"},
    {"velu":"Mi arb nov en urb ra vis.","english":"I saw a new tree in the city."},
    {"velu":"Mi lib nov por ami na mi sa pag.","english":"I will buy a new book for my friend."},
    {"velu":"Mi mel no kel, pork mi fel no so.","english":"I don't want to eat, because I'm not happy."},
    {"velu":"Sen tu ku, mi pan a tu sa do.","english":"If you come, I will give bread to you."},
    {"velu":"Ub kas na tu?","english":"Where is your house?"},
    {"velu":"Ke nom na tu?","english":"What is your name?"},
    {"velu":"Nom na mi Zo so.","english":"My name is Zo."},
    {"velu":"En kas aka ten.","english":"There is water in the house."},
    {"velu":"A kas ga!","english":"Go home!"},
    {"velu":"Gat aka bi.","english":"The cat drinks water."},
    {"velu":"Miji a kas gran sa ga.","english":"We will go to the big house."},
    {"velu":"Ki ami na tu so?","english":"Who is your friend?"},
    {"velu":"Nin lib nov ta lek.","english":"The child is reading a new book."},
    {"velu":"Lo en kas na ami ra dor.","english":"He/she slept in the friend's house."},
    {"velu":"Mi ub tu vi no sab.","english":"I don't know where you live."},
    {"velu":"Tri hom pan ta mel.","english":"Three people are eating bread."},
    {"velu":"Sal! Kom tu ka?","english":"Hi! How are you?"},
    {"velu":"Mi bon. Gras! E tu?","english":"I'm good, thanks! And you?"},
    {"velu":"Mi fel, pork sol bel so.","english":"I'm happy because the sun is beautiful."},
    {"velu":"Tu a urb sa ga ka?","english":"Will you go to the city?"},
    {"velu":"Si. Mi pan e lib sa pag.","english":"Yes. I'll buy bread and a book."}
